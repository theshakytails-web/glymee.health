{
  "name": "glymee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:secret:key": "wrangler secret put MAILCHANNELS_API_KEY",
    "worker:secret:account": "wrangler secret put MAILCHANNELS_ACCOUNT_ID",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file=.env node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "seed:admin": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/seed-admin.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@google-cloud/storage": "^7.21.0",
    "@libsql/client": "^0.17.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "highcharts": "^13.0.0",
    "highcharts-react-official": "^3.2.3",
    "jose": "^6.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
